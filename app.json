{
  "expo": {
    "name": "2du",
    "slug": "2du",
    "version": "1.0.1",
    "scheme": "x2du",
    "platforms": ["ios", "android", "web"],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/logo.png"
    },
    "plugins": ["expo-router", "expo-sqlite", "expo-secure-store", "expo-font", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0c0a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d0c0a"
      },
      "package": "com.hyp3.x2du"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4df9c2d-9294-4429-817b-70019309937b"
      }
    }
  }
}
